# Production environment variables for the VOID API
DB_URL=jdbc:mysql://mysql:3306/void_store?useUnicode=true&characterEncoding=utf8&connectionTimeZone=UTC
DB_USER=void
DB_PASSWORD=change-me
# REQUIRED: output of `openssl rand -base64 48`. This placeholder is rejected at startup on purpose.
JWT_SECRET=
# Optional: CIDR list of reverse proxies whose X-Forwarded-For is trusted (default: loopback + private networks)
# TRUSTED_PROXIES=172.18.0.0/16
COOKIE_SECURE=true
FRONTEND_URL=https://your-domain.com
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=VOID <orders@your-domain.com>
UPLOADS_DIR=/data/uploads
OWNER_EMAIL=you@your-domain.com
OWNER_PASSWORD=choose-a-strong-password
