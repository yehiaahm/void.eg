# Copy to .env on the server and fill in. Never commit the real .env.

# Your domain, without https:// (DNS A record must point to the server first)
DOMAIN=void-store.com

# Database passwords — generate long random strings
DB_PASSWORD=
DB_ROOT_PASSWORD=

# 48+ random bytes, e.g.:  openssl rand -base64 48
JWT_SECRET=

# Email (order confirmations, password resets). Any SMTP provider: Gmail Workspace, Zoho, Brevo, Resend…
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=VOID <orders@void-store.com>

# First owner account (created on first start, ignored afterwards). Password: 10+ characters.
OWNER_EMAIL=
OWNER_PASSWORD=
OWNER_NAME=Owner
